# Local development only. Never commit your real .env file.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-this-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

DATABASE_URL=

# Leave blank to print verification emails in the development console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@localhost
